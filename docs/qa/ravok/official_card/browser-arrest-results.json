  "dialogue": [
    {
      "speaker": "ZORPZIN",
      "text": "Não.",
      "phase": "REFUSAL"
    },
    {
      "speaker": "RAVOK",
      "text": "Você não entendeu.",
      "phase": "MISUNDERSTANDING"
    },
    {
      "speaker": "ZORPZIN",
      "text": "Entendi perfeitamente.",
      "phase": "UNDERSTOOD"
    },
    {
      "speaker": "ZORPZIN",
      "text": "Você não voltou porque queria vencer.",
      "phase": "TRUTH_ONE"
    },
    {
      "speaker": "ZORPZIN",
      "text": "Voltou porque nunca conseguiu aceitar que perdeu.",
      "phase": "TRUTH_TWO"
    },
    {
      "speaker": "RAVOK",
      "text": "Você não sabe nada sobre mim.",
      "phase": "FURY"
    },
    {
      "speaker": "K7",
      "text": "PARTIDA IMEDIATA RECOMENDADA.",
      "phase": "K7_ALERT"
    },
    {
      "speaker": "RAVOK",
      "text": "O que você fez?",
      "phase": "WHAT_DID_YOU_DO"
    },
    {
      "speaker": "ZORPZIN",
      "text": "Chamei quem deveria ter sido chamado há muito tempo.",
      "phase": "COORDINATES_SENT"
    },
    {
      "speaker": "K7",
      "text": "ROTA DE FUGA BLOQUEADA.",
      "phase": "ESCAPE_BLOCKED"
    },
    {
      "speaker": "OFICIAL",
      "text": "Ravok Noxaris.",
      "phase": "OFFICER_NAME"
    },
    {
      "speaker": "OFICIAL",
      "text": "Você está detido por desenvolvimento de armamento planetário proibido, violação do código de não intervenção e tentativa de ataque contra uma civilização protegida.",
      "phase": "OFFICER_CHARGES"
    },
    {
      "speaker": "RAVOK",
      "text": "Você poderia ter sido lembrado para sempre.",
      "phase": "REMEMBERED"
    },
    {
      "speaker": "ZORPZIN",
      "text": "Eu já tenho oito coisas para lembrar desta viagem.",
      "phase": "EIGHT_MEMORIES"
    },
    {
      "speaker": "K7",
      "text": "PROTOCOLO ENCERRADO.",
      "phase": "PROTOCOL_CLOSED"
    }
  ],
