  "arrivalLines": [
    {
      "speaker": "RAVOK",
      "text": "Então é verdade..."
    },
    {
      "speaker": "K7",
      "text": "QUATRO ASSINATURAS CONFIRMADAS."
    },
    {
      "speaker": "RAVOK",
      "text": "Vamos ver até onde ele consegue chegar."
    }
  ],
  "proposalLines": [
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Então você conseguiu.",
      "index": 0,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Todas as oito.",
      "index": 1,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Era para isso que eu vim.",
      "index": 2,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Eu também vim à Terra por esse motivo.",
      "index": 3,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Há muito tempo.",
      "index": 4,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Mesmo planeta.",
      "index": 5,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Mesmos Mestres.",
      "index": 6,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Mesmo objetivo.",
      "index": 7,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Mas eu falhei.",
      "index": 8,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Eu voltei para casa sem nada.",
      "index": 9,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Enquanto eles ficaram aqui...",
      "index": 10,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "...como se nunca tivesse acontecido.",
      "index": 11,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Você perdeu competições.",
      "index": 12,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Isso acontece.",
      "index": 13,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Eu não voltei para tentar de novo.",
      "index": 14,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Voltei para terminar isso de outra maneira.",
      "index": 15,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Não.",
      "index": 16,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Nem ouviu minha proposta.",
      "index": 17,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Não preciso.",
      "index": 18,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Usar nossa tecnologia para atacar uma civilização que não pode se defender dela é proibido por uma das leis fundamentais da nossa espécie.",
      "index": 19,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "Não é competição.",
      "index": 20,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "ZORPZIN",
      "text": "É abuso.",
      "index": 21,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Leis.",
      "index": 22,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Você venceu todos eles.",
      "index": 23,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Provou que é melhor que este planeta.",
      "index": 24,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Você realmente quer voltar para casa carregando apenas oito pedaços de metal?",
      "index": 25,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Eu tenho algo maior.",
      "index": 26,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "RAVOK",
      "text": "Algo que ninguém do nosso planeta esqueceria.",
      "index": 27,
      "total": 29,
      "selected": 1,
      "error": null
    },
    {
      "type": "DIALOGUE",
      "speaker": "K7",
      "text": "PROTOCOLO DISPONÍVEL.",
      "index": 28,
      "total": 29,
      "selected": 1,
      "error": null
    }
  ],
